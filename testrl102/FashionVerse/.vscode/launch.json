{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI Backend (FashionVerse)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run PPO Training (Quick)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/training/train_ppo.py",
      "args": ["--quick"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Evaluate & Generate Plots",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/training/evaluate.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Generate Presentation PPTX",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/generate_ppt.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run Pytest Test Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
